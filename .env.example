# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# These are the same variable names the existing Zapier Code steps use.

# Retell AI — used by the list-calls puller (PR 3)
RETELL_API_KEY=

# Optional — base URL of the Retell *dashboard* (web UI). The dashboard builds a
# call-transcript link as {RETELL_DASHBOARD_URL}/call-history?history={call_id}.
# If your dashboard's per-call URL differs, set the full template below instead.
# RETELL_DASHBOARD_URL=https://dashboard.retellai.com
# RETELL_CALL_URL_TEMPLATE=https://dashboard.retellai.com/call-history?history={call_id}

# Odoo CRM REST API — used by the lead puller (PR 2)
# ODOO_URL is the base URL of the Odoo REST endpoint (no trailing slash).
ODOO_URL=
ODOO_API_KEY=

# Base URL of the Odoo *web UI* (e.g. https://dkbinc.co), used to build
# click-through links to a caller's lead as {ODOO_WEB_URL}/odoo/crm/{lead_id}.
# Distinct from ODOO_URL (the REST endpoint, which may be a proxy). Leave blank
# to hide the Odoo links. Set the full template below if your lead path differs.
ODOO_WEB_URL=
# ODOO_LEAD_URL_TEMPLATE=https://dkbinc.co/odoo/crm/{lead_id}

# Optional — grace window (hours) for the "new client from after-hours" metric.
# A matched caller counts as a NEW client won by the after-hours agent when their
# Odoo lead was created no earlier than their first after-hours call minus this
# window (i.e. they weren't in the CRM before they called). It absorbs the lag
# between the call and the Zapier step creating the lead. Default 12. Widen it if
# genuine new callers are missed; tighten it if existing clients leak in.
# RETELL_NEW_CLIENT_GRACE_HOURS=12

# Lead follow-up SLA digest (Phase 3) — email when an after-hours caller hasn't
# been called back. Detection is read-only over data already pulled: a matched
# after-hours lead is "overdue" when its call is older than the SLA window, the rep
# hasn't advanced its stage (still at the entry level, or in the un-actioned list
# below), and it isn't won/lost. Set RETELL_ALERT_ENABLED=true to send the digest
# at the end of the nightly `run`; `python -m retell_sync alert` sends on demand
# (add --dry-run to only preview).
# RETELL_ALERT_ENABLED=false
# RETELL_ALERT_SLA_HOURS=48
# Comma-separated raw Odoo stage names that count as "not yet called back" on top
# of the funnel entry level. Defaults to DKB's freshly-created stages.
# RETELL_ALERT_UNACTIONED_STAGES=Imported - Need to Assign Stage,New Customer / Need Info

# M365 / Microsoft Graph send (client-credentials flow) for the SLA digest above.
# On the server these live as machine env vars, NOT in this file — see SETUP.md for
# the Entra app registration (application Mail.Send + admin consent + client secret,
# scoped to the sender mailbox via an Application Access Policy). Listed here only so
# a developer can test delivery locally.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# ALERT_FROM=afterhours@dkbinc.co
# Recipient(s) of the manager digest, comma-separated (the fallback until the in-app editor).
# ALERT_TO=you@dkbinc.co

# Per-salesperson digests: in addition to the manager digest above, email each rep
# a digest of only their own overdue leads. Rep->email is looked up from Odoo
# res.users (matched on the salesperson name); ALERT_REP_EMAILS overrides fill any
# gaps (or fix a wrong address). Format: "Name=addr;Other Name=addr2".
# RETELL_ALERT_PER_REP=false
# ALERT_REP_EMAILS=Jane Doe=jane@dkbinc.co;Rob Roe=rob@dkbinc.co
