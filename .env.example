# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# These are the same variable names the existing Zapier Code steps use.

# Retell AI — used by the list-calls puller (PR 3)
RETELL_API_KEY=

# Optional — base URL of the Retell *dashboard* (web UI), used to build
# click-through links to each call's transcript. Defaults to the value below;
# only override if your dashboard host differs.
# RETELL_DASHBOARD_URL=https://dashboard.retellai.com

# Odoo CRM REST API — used by the lead puller (PR 2)
# ODOO_URL is the base URL of the Odoo REST endpoint (no trailing slash).
ODOO_URL=
ODOO_API_KEY=

# Optional — base URL of the Odoo *web UI* (e.g. https://yourco.odoo.com), used
# to build click-through links to a caller's lead. Distinct from ODOO_URL (the
# REST endpoint, which may be a proxy). Leave blank to hide the Odoo links.
# ODOO_WEB_URL=
