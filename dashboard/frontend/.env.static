# Loaded by Vite for `vite build --mode static` (see the `build:static` script).
# The internal read-only web viewer has no .NET host, so the built app reads a
# sibling conversion.json served next to index.html instead of the /api route.
VITE_CONVERSION_URL=./conversion.json

# The cross-run KPI history for the Trends page — a sibling file next to
# conversion.json, served by the same static host (no /api route in this build).
VITE_HISTORY_URL=./history.json

# Marks this as the read-only static viewer build (no .NET host). The Settings
# page is still shown — its Appearance/Display prefs are pure browser settings —
# but its host-only alert-delivery editor (which needs /api/settings) hides itself,
# so a salesperson viewing the static export never sees the recipient editor.
VITE_STATIC=true
