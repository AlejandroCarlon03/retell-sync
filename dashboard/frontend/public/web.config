<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS cache policy for the internal static web viewer.

  Vite copies everything in public/ verbatim into dist/, and Update-Dashboard.ps1
  deploys dist/ to the IIS web root — so this file ships with every static build
  and needs no server-side hand-editing.

  The problem it fixes: index.html points at content-hashed bundles under /assets.
  Without explicit headers the browser (and WebView2) heuristically cache
  index.html, so after a redeploy it keeps requesting the OLD hashes — which the
  deploy just purged — and the dashboard looks stale (or breaks) until a manual
  Ctrl+F5. The rule below is the standard SPA split:

    * /assets/*        content-hashed, so cache hard + immutable (a new build =
                       new filenames, never a stale hit).
    * index.html       always revalidate, so a redeploy shows up on the next load.
    * conversion.json  the live data the nightly task republishes; never cache it.

  Only core IIS static-content features are used (no URL Rewrite module needed).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Ensure the published data file is served as JSON. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>

  <!-- Content-hashed bundles: safe to cache for a year, immutable. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- The entry document: always revalidate so a new deploy is picked up at once. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Live data republished by the refresh task: never serve a stale copy. -->
  <location path="conversion.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
